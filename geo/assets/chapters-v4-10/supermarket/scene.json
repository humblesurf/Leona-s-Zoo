  "dialogue": {
    "shopmilk": {
      "name": {
        "en": "Milk",
        "cmn": "牛奶",
        "yue": "牛奶"
      },
      "emoji": "🥛",
      "intro": {
        "en": "I'm milk. Pour me into a cup. A little sip!",
        "cmn": "我是牛奶。把我倒进杯子里，小口喝一喝！",
        "yue": "我係牛奶。倒我入杯仔度，飲一小啖啦！"
      },
      "kind": "discovery"
    },
    "shopbread": {
      "name": {
        "en": "Bread",
        "cmn": "面包",
        "yue": "麵包"
      },
      "emoji": "🍞",
      "intro": {
        "en": "I'm bread. I have a golden crust and a soft middle.",
        "cmn": "我是面包。我的外皮金黄金黄，里面软软的。",
        "yue": "我係麵包。我嘅外皮金黃色，入面軟綿綿。"
      },
      "kind": "discovery"
    },
    "shopeggs": {
      "name": {
        "en": "Eggs",
        "cmn": "鸡蛋",
        "yue": "雞蛋"
      },
      "emoji": "🥚",
      "intro": {
        "en": "We're eggs. Our shells are delicate. Carry us gently!",
        "cmn": "我们是鸡蛋。蛋壳容易碰破，轻轻地拿着我们吧！",
        "yue": "我哋係雞蛋。蛋殼好容易撞爛，輕輕拎住我哋啦！"
      },
      "kind": "discovery"
    },
    "shopyogurt": {
      "name": {
        "en": "Yogurt",
        "cmn": "酸奶",
        "yue": "乳酪"
      },
      "emoji": "🥣",
      "intro": {
        "en": "I'm yogurt. I'm cool and creamy. Use a little spoon!",
        "cmn": "我是酸奶。我凉凉的、滑滑的，用小勺子吃吧！",
        "yue": "我係乳酪。我涼涼哋、滑滑哋，用小匙羹食啦！"
      },
      "kind": "discovery"
    },
    "shoptissue": {
      "name": {
        "en": "Tissues",
        "cmn": "纸巾",
        "yue": "紙巾"
      },
      "emoji": "🧻",
      "intro": {
        "en": "I'm a tissue box. Take one soft tissue to wipe your hands.",
        "cmn": "我是纸巾盒。抽一张软软的纸巾，擦擦小手。",
        "yue": "我係紙巾盒。抽一張軟熟嘅紙巾，抹下小手啦。"
      },
      "kind": "discovery"
    },
    "shopcart": {
      "name": {
        "en": "Shopping cart",
        "cmn": "购物车",
        "yue": "購物車"
      },
      "emoji": "🛒",
      "intro": {
        "en": "I'm a shopping cart. My wheels roll as we shop together!",
        "cmn": "我是购物车。轮子转呀转，我们一起逛超市！",
        "yue": "我係購物車。轆仔轉呀轉，我哋一齊行超市！"
      },
      "kind": "discovery"
    },
    "shopbasket": {
      "name": {
        "en": "Shopping basket",
        "cmn": "购物篮",
        "yue": "購物籃"
      },
      "emoji": "🧺",
      "intro": {
        "en": "I'm a shopping basket. Put our groceries inside. Let's count!",
        "cmn": "我是购物篮。把买的东西放进来，一起数一数！",
        "yue": "我係購物籃。將買嘅嘢放入嚟，一齊數下啦！"
      },
      "kind": "discovery"
    }
