  "dialogue": {
    "spacemoon": {
      "name": {
        "en": "Moon",
        "cmn": "月球",
        "yue": "月球"
      },
      "emoji": "🌕",
      "intro": {
        "en": "I'm the Moon. I'm round, with craters on my rocky surface.",
        "cmn": "我是月球，圆圆的。我的岩石表面有好多月面坑。",
        "yue": "我係月球，圓碌碌。我嘅石頭表面有好多月面坑。"
      },
      "kind": "discovery"
    },
    "spacecrater": {
      "name": {
        "en": "Moon crater",
        "cmn": "月面坑",
        "yue": "月面坑"
      },
      "emoji": "🌑",
      "intro": {
        "en": "I'm a Moon crater. A space rock made this big, round hollow.",
        "cmn": "我是月面坑。太空里的石头撞上月球，留下了这个圆圆的大坑。",
        "yue": "我係月面坑。太空嘅石頭撞落月球，留下呢個圓圓嘅大坑。"
      },
      "kind": "discovery"
    },
    "spacelunarrover": {
      "name": {
        "en": "Moon rover",
        "cmn": "月球车",
        "yue": "月球車"
      },
      "emoji": "🛞",
      "intro": {
        "en": "I'm a Moon rover. My four wheels help me explore the Moon.",
        "cmn": "我是月球车。四个轮子转呀转，带我去探索月球。",
        "yue": "我係月球車。四個轆轉呀轉，帶我去探索月球。"
      },
      "kind": "discovery"
    },
    "spacemars": {
      "name": {
        "en": "Mars",
        "cmn": "火星",
        "yue": "火星"
      },
      "emoji": "🔴",
      "intro": {
        "en": "I'm Mars, the red planet. My dusty ground is rocky and dry.",
        "cmn": "我是火星，红红的星球。我的地面很干燥，还有好多石头。",
        "yue": "我係火星，紅紅嘅星球。我嘅地面好乾燥，仲有好多石頭。"
      },
      "kind": "discovery"
    },
    "spacemarsrover": {
      "name": {
        "en": "Mars rover",
        "cmn": "火星探测车",
        "yue": "火星探測車"
      },
      "emoji": "🤖",
      "intro": {
        "en": "I'm a Mars rover. My six wheels roll over rocks as I explore Mars.",
        "cmn": "我是火星探测车。六个轮子越过石头，带我去探索火星。",
        "yue": "我係火星探測車。六個轆行過石頭，帶我去探索火星。"
      },
      "kind": "discovery"
    }
