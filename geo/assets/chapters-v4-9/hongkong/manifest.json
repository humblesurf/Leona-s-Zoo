  "dialogue": {
    "hkferry": {
      "name": {
        "en": "Star Ferry",
        "cmn": "天星小轮",
        "yue": "天星小輪"
      },
      "emoji": "⛴️",
      "intro": {
        "en": "I'm the Star Ferry! My green and white boat carries people across Victoria Harbour.",
        "cmn": "我是天星小轮！我穿着绿白相间的外衣，载着大家穿过维多利亚港。",
        "yue": "我係天星小輪！我着住綠色同白色嘅外衣，載大家過維多利亞港。"
      },
      "kind": "discovery"
    },
    "hktram": {
      "name": {
        "en": "Ding Ding tram",
        "cmn": "叮叮车",
        "yue": "叮叮車"
      },
      "emoji": "🚋",
      "intro": {
        "en": "I'm a Ding Ding tram! I have two decks and travel along rails. Ding, ding!",
        "cmn": "我是叮叮车！我有上下两层，沿着铁轨慢慢走。叮叮！",
        "yue": "我係叮叮車！我有上下兩層，沿住路軌慢慢行。叮叮！"
      },
      "kind": "discovery"
    },
    "hkbus": {
      "name": {
        "en": "Double-decker bus",
        "cmn": "双层巴士",
        "yue": "雙層巴士"
      },
      "emoji": "🚌",
      "intro": {
        "en": "I'm a double-decker bus! I have seats downstairs and upstairs. Let's explore Hong Kong!",
        "cmn": "我是双层巴士！楼下和楼上都有座位。一起看看香港吧！",
        "yue": "我係雙層巴士！樓下同樓上都有座位。一齊睇吓香港啦！"
      },
      "kind": "discovery"
    },
    "hkboc": {
      "name": {
        "en": "Bank of China Tower",
        "cmn": "中银大厦",
        "yue": "中銀大廈"
      },
      "emoji": "🏙️",
      "intro": {
        "en": "I'm the Bank of China Tower! Look at my tall shape and big triangles. My windows can shine!",
        "cmn": "我是中银大厦！看看我高高的身体和大大的三角形。我的窗户会亮起来！",
        "yue": "我係中銀大廈！睇吓我高高嘅身同大大嘅三角形。我嘅窗會發光！"
      },
      "kind": "discovery"
    },
    "hkclock": {
      "name": {
        "en": "Clock Tower",
        "cmn": "尖沙咀钟楼",
        "yue": "尖沙咀鐘樓"
      },
      "emoji": "🕰️",
      "intro": {
        "en": "I'm the Clock Tower in Tsim Sha Tsui! I'm made of red bricks and pale stone. Look up at my clock!",
        "cmn": "我是尖沙咀钟楼！我由红砖和浅色石头建成。抬头看看我的时钟吧！",
        "yue": "我係尖沙咀鐘樓！我用紅磚同淺色石頭砌成。抬頭睇吓我個鐘啦！"
      },
      "kind": "discovery"
    },
    "hkdim": {
      "name": {
        "en": "Dim sum shop",
        "cmn": "点心铺",
        "yue": "點心舖"
      },
      "emoji": "🥟",
      "intro": {
        "en": "Welcome to the dim sum shop! Little bamboo baskets hold buns and dumplings. Warm steam rises softly.",
        "cmn": "欢迎来到点心铺！小竹蒸笼里有包子和饺子。温暖的蒸汽轻轻飘起来。",
        "yue": "歡迎嚟到點心舖！小竹蒸籠入面有包同餃子。暖暖嘅蒸氣輕輕升起。"
      },
      "kind": "discovery"
    }
  }
}
