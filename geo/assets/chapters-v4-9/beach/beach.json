  "dialogue": {
    "beachumbrella": {
      "name": {
        "en": "Beach umbrella",
        "cmn": "遮阳伞",
        "yue": "太陽傘"
      },
      "emoji": "⛱️",
      "intro": {
        "en": "I'm a beach umbrella. My shade makes a cool little spot on the sand.",
        "cmn": "我是遮阳伞，在沙滩上撑起一片凉凉的阴影。",
        "yue": "我係太陽傘，喺沙灘撐起一片涼涼嘅陰影。"
      },
      "kind": "discovery"
    },
    "beachbucket": {
      "name": {
        "en": "Sand bucket",
        "cmn": "沙桶",
        "yue": "沙桶"
      },
      "emoji": "🪣",
      "intro": {
        "en": "I'm a sand bucket. Fill me with sand, then tip me over to make a little tower.",
        "cmn": "我是沙桶，装满沙子，倒过来，就变成小塔啦！",
        "yue": "我係沙桶，裝滿沙，再倒轉，就變成小塔喇！"
      },
      "kind": "discovery"
    },
    "beachshovel": {
      "name": {
        "en": "Shovel",
        "cmn": "铲子",
        "yue": "鏟仔"
      },
      "emoji": "🏖️",
      "intro": {
        "en": "I'm a shovel. Scoop, scoop! Let's dig a small hole in the sand.",
        "cmn": "我是铲子，铲呀铲，一起挖个小沙坑！",
        "yue": "我係鏟仔，鏟呀鏟，一齊挖個小沙坑！"
      },
      "kind": "discovery"
    },
    "beachshell": {
      "name": {
        "en": "Seashell",
        "cmn": "贝壳",
        "yue": "貝殼"
      },
      "emoji": "🐚",
      "intro": {
        "en": "I'm a seashell. Look at my ridges. A little sea animal once lived inside.",
        "cmn": "我是贝壳，身上有一条条纹路。小海洋动物曾经住在里面。",
        "yue": "我係貝殼，身上有一條條紋路。小海洋動物曾經住喺入面。"
      },
      "kind": "discovery"
    },
    "beachcastle": {
      "name": {
        "en": "Sandcastle",
        "cmn": "沙堡",
        "yue": "沙堡"
      },
      "emoji": "🏰",
      "intro": {
        "en": "I'm a sandcastle. Stack the sandy towers and pat them gently. Ta-da!",
        "cmn": "我是沙堡，堆起小沙塔，轻轻拍一拍。完成啦！",
        "yue": "我係沙堡，堆起小沙塔，輕輕拍一拍。完成喇！"
      },
      "kind": "discovery"
    },
    "beachcrab": {
      "name": {
        "en": "Little crab",
        "cmn": "小螃蟹",
        "yue": "小蟹"
      },
      "emoji": "🦀",
      "intro": {
        "en": "I'm a little crab. My little legs help me scuttle sideways across the sand.",
        "cmn": "我是小螃蟹，小脚带着我横着走过沙滩。",
        "yue": "我係小蟹，小腳帶住我橫住行過沙灘。"
      },
      "kind": "discovery"
    },
    "beachwave": {
      "name": {
        "en": "Wave",
        "cmn": "海浪",
        "yue": "海浪"
      },
      "emoji": "🌊",
      "intro": {
        "en": "I'm a wave. I roll onto the shore, then slide back into the sea. Whoosh!",
        "cmn": "我是海浪，轻轻冲上岸，再退回海里。哗啦啦！",
        "yue": "我係海浪，輕輕湧上岸，再退返海入面。嘩啦啦！"
      },
      "kind": "discovery"
    }
  }
